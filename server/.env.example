# ─────────────────────────────────────────────────────────────
# VulnTrack API — environment variables
# Copy to server/.env for local development. Never commit .env.
# Full reference: docs/authentication/environment.md
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# MongoDB. Must be a replica set (transactions). docker-compose.yml provides one locally;
# MongoDB Atlas clusters are replica sets.
MONGODB_URI=mongodb://127.0.0.1:27018/vulntrack?replicaSet=rs0&directConnection=true

# Browser origin of the web app (email links + CSRF origin check).
APP_ORIGIN=http://localhost:5173
# Optional extra allowed origins, comma-separated.
ALLOWED_ORIGINS=

# REQUIRED. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Reverse proxy hops in front of the API (Railway: 1). Controls client IP for rate limiting.
TRUST_PROXY=0

# Session cookie. COOKIE_SECURE defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12
SESSION_REMEMBER_DAYS=30

# Email. "log" prints links to the server log (development only).
# "smtp" sends real mail — for local testing use Mailpit from docker-compose (UI: http://localhost:8025).
EMAIL_TRANSPORT=log
EMAIL_FROM=VulnTrack <no-reply@vulntrack.local>
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

LOG_LEVEL=info
LOG_PRETTY=true
