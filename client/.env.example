# VulnTrack web client — optional environment variables (copy to client/.env.local).

# API base URL for deployed builds. Leave empty to use same-origin "/api"
# (dev: proxied by Vite; prod: route /api to the API on the same site).
VITE_API_BASE_URL=

# Development proxy target for "/api".
VITE_API_PROXY_TARGET=http://localhost:4000

# "api" (default) uses the real backend. "mock" (development only) uses the
# deterministic design-preview mock so every UI state can be shown without a server.
VITE_AUTH_MODE=api
